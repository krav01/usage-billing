{
  "uid": "usage-billing",
  "title": "Usage Billing - Operations",
  "tags": [
    "usage-billing",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Pending events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "billing-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(usage_billing_queue_pending_events{job=\"usage-billing\"})",
          "legendFormat": "Pending events"
        }
      ]
    },
    {
      "id": 2,
      "title": "Oldest pending event",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "billing-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(usage_billing_queue_oldest_event_age_seconds{job=\"usage-billing\"})",
          "legendFormat": "Oldest pending event"
        }
      ]
    },
    {
      "id": 3,
      "title": "Worker throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "billing-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(usage_billing_worker_events_processed_total{job=\"usage-billing\"}[5m]))",
          "legendFormat": "Worker throughput"
        }
      ]
    },
    {
      "id": 4,
      "title": "Worker batch error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "billing-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "usage_billing:worker_error_ratio:5m{job=\"usage-billing\"}",
          "legendFormat": "Worker batch error ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Event API requests by status class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "billing-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(usage_billing_http_requests_total{job=\"usage-billing\",route=\"accept\"}[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Target, queue scrape, and worker health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "billing-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"usage-billing\"}",
          "legendFormat": "Prometheus scrape"
        },
        {
          "refId": "B",
          "expr": "usage_billing_queue_scrape_success{job=\"usage-billing\"}",
          "legendFormat": "Queue query"
        },
        {
          "refId": "C",
          "expr": "usage_billing_worker_running{job=\"usage-billing\"}",
          "legendFormat": "Worker"
        }
      ]
    }
  ]
}
